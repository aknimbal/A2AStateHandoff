# Copy to .env and replace every secret with your own values.
# .env is gitignored; never commit real credentials.

# --- Authentication ---------------------------------------------------------
AUTH_ENABLED=true
AUTH_HEADER_NAME=Authorization
AUTH_SCHEME=Bearer
# Reject requests that resume a session created by a different client.
AUTH_SESSION_BINDING_ENABLED=true
# HMAC key used to sign the credential passed between agents.
HANDOFF_SIGNING_SECRET=replace-with-a-long-random-value

# --- Clients ----------------------------------------------------------------
# Every client listed here needs AUTH_CLIENT_<ID>_TOKEN and AUTH_CLIENT_<ID>_SCOPES.
# <ID> is the client id uppercased with non-alphanumeric characters replaced by "_".
AUTH_CLIENT_IDS=buyer-portal,inventory-bot

AUTH_CLIENT_BUYER_PORTAL_TOKEN=replace-with-buyer-portal-secret
AUTH_CLIENT_BUYER_PORTAL_SCOPES=intake.write,inventory.read,quote.read,order.write

AUTH_CLIENT_INVENTORY_BOT_TOKEN=replace-with-inventory-bot-secret
AUTH_CLIENT_INVENTORY_BOT_SCOPES=intake.write,inventory.read

# Credential used by the CLI (python -m handoff.orchestrator) when --token is omitted.
CLIENT_TOKEN=replace-with-buyer-portal-secret

# --- Agents -----------------------------------------------------------------
AGENT_NAMES=intake,inventory,quote,confirmation
AGENT_ENTRY_POINT=intake
AGENT_SCOPE_INTAKE=intake.write
AGENT_SCOPE_INVENTORY=inventory.read
AGENT_SCOPE_QUOTE=quote.read
AGENT_SCOPE_CONFIRMATION=order.write

# --- State storage ----------------------------------------------------------
STATE_STORE_PATH=./.local/a2a-state.json
